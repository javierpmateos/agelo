{
  "name": "agelo",
  "version": "1.0.0",
  "description": "Autonomous AI agent that pays for services via x402 using Tether WDK",
  "type": "module",
  "scripts": {
    "marketplace": "tsx src/services/marketplace.ts",
    "agent": "tsx src/agent/agent.ts",
    "start": "tsx src/index.ts",
    "bridge": "tsx src/wallet/bridge.ts",
    "mcp": "tsx src/mcp/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@tetherto/wdk": "^1.0.0-beta.6",
    "@tetherto/wdk-protocol-bridge-usdt0-evm": "latest",
    "@tetherto/wdk-protocol-lending-aave-evm": "^1.0.0-beta.3",
    "@tetherto/wdk-protocol-swap-velora-evm": "^1.0.0-beta.4",
    "@tetherto/wdk-wallet-evm": "latest",
    "@x402/core": "latest",
    "@x402/evm": "latest",
    "@x402/express": "latest",
    "@x402/fetch": "latest",
    "chalk": "^5.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^4.1.0",
    "tsx": "^4.6.2",
    "typescript": "^5.3.2",
    "vitest": "^4.1.0"
  },
  "vitest": {
    "environment": "node",
    "globals": true
  }
